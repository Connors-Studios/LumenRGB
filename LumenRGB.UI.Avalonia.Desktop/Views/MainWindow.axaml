<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LumenRGB.UI.Avalonia.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:anim="using:Avalonia.Animation"
        xmlns:controls="using:Avalonia.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="600"
        Width="1200"
        Height="600"
        SizeToContent="Manual"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        TransparencyLevelHint="AcrylicBlur"
        WindowDecorations="Full"
        x:Class="LumenRGB.UI.Avalonia.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/LumenRGB_arc_256.ico"
        Title="LumenRGB">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="120,*">

        <!-- LEFT SIDEBAR -->
        <Grid Background="#222" Margin="10,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP GROUP -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">

                <Button Classes="sidebar"
                        Content="Home"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Home"/>

                <Button Classes="sidebar"
                        Content="Devices"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Devices"/>

            </StackPanel>

            <!-- SPACER -->
            <Border Grid.Row="1"/>

            <!-- BOTTOM GROUP -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">

                <Button Classes="sidebar"
                        Content="Settings"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Settings"/>

                <Button Classes="sidebar"
                        Content="About"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="About"/>

            </StackPanel>

        </Grid>

        <!-- MAIN CONTENT AREA -->
        <controls:TransitioningContentControl Grid.Column="1"
                                              Content="{Binding CurrentPage}"
                                              Margin="10">
            <controls:TransitioningContentControl.PageTransition>
                <anim:CrossFade Duration="0:0:0.25"/>
            </controls:TransitioningContentControl.PageTransition>
        </controls:TransitioningContentControl>

    </Grid>

</Window>
