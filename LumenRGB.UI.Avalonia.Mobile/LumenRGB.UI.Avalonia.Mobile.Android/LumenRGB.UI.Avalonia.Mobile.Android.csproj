<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
	<TargetPlatformVersion>36.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.ConnorsStudios.LumenRGB</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	<AssemblyName>LumenRGB</AssemblyName>
	<ExecutableName>LumenRGB</ExecutableName>
	<ApplicationTitle>LumenRGB</ApplicationTitle>
  </PropertyGroup>
	
  <ItemGroup>
    <AndroidResource Include="LumenRGB_arc_256.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <!-- Pin core-ktx to match the transitively-resolved Xamarin.AndroidX.Core
         (1.19.x via SplashScreen) — a version skew makes both ship AnimatorKt
         and the D8 dexer fails with "Type ... is defined multiple times". -->
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
    <!-- Pin lagging AndroidX.Lifecycle packages forward to match Common/Runtime
         (resolved at 2.11.0.1), clearing the NU1608 version-skew warnings. -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumenRGB.UI.Avalonia.Mobile\LumenRGB.UI.Avalonia.Mobile.csproj" />
  </ItemGroup>
</Project>
